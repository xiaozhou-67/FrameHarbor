# Copy to .env. Set a strong password before the first application startup.
HOST=127.0.0.1
# For a local HTTPS reverse proxy in production, set to loopback.
# For remote proxies, list only their exact trusted IP addresses/CIDRs, comma-separated.
TRUST_PROXY=
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=./data/frameharbor.sqlite
ADMIN_EMAIL=admin@frameharbor.local
ADMIN_PASSWORD=
ADMIN_NAME=帧港运营
DEMO_PAYMENTS=true
SEED_DEMO=true
NODE_ENV=development
