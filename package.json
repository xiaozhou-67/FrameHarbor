{
  "name": "frameharbor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "帧港：电影发现、选座购票与影院运营平台，基于 FilmSys 业务重新设计。",
  "author": {
    "name": "Changqing Zhou",
    "email": "zcq@njfu.edu.cn"
  },
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.10.0 <25 || >=26"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "node --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "audit:source": "node tools/static-audit.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run audit:source"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "vue": "3.5.44",
    "vue-router": "^4.6.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "7.3.7",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "3.3.13"
  }
}
